TP_DATABASE_URL=postgresql+asyncpg://postgres:<password>@postgres:5432/tradingpilot
TP_REDIS_URL=redis://redis:6379/0
TP_ENABLED_MODULES=tradingview,market_data,signal_engine,ml_strategy,risk_engine,execution,positions,auth,settings,dashboard,markets
TP_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT
TP_TIMEFRAME_ALLOWLIST=1m,5m,15m,1h
TP_TV_WEBHOOK_SECRET=change-me
TP_SESSION_COOKIE_SECURE=false
TP_ENABLE_LIVE_TRADING=false
TP_ADMIN_USERNAME=admin
TP_ADMIN_PASSWORD=change-me-now
TP_ADMIN_PASSWORD_HASH=
TP_ADMIN_ROLE=paper
TP_METRICS_INTERVAL_SECONDS=60
# ML strategy: shadow | primary | confirm
TP_ML_STRATEGY_MODE=shadow
TP_ML_MODEL_DIR=/app/models
TP_ML_INFERENCE_BARS=400
TP_ML_TRAINING_STALE_SECONDS=3600
TP_MARKET_DATA_BAR_LIMIT=200
